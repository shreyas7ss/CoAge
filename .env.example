DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/colearn
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
SELF_CONSISTENCY_RUNS=2
CONFIDENCE_REVIEW_THRESHOLD=0.75
AUTO_APPROVE_ENABLED=false
# Change this to a strong random value (>= 32 chars) in production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
STORAGE_DIR=./storage
# Optional tracing
LANGSMITH_TRACING=false
